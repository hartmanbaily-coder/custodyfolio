# Custody Folio off-site evidence backup credentials.
# Copy to /srv/losttofound/config/backup.env with owner losttofound and mode 0600.
# Never add the real file or credentials to Git.

OFFSITE_BACKUP_S3_ENDPOINT=https://s3.REPLACE_WITH_REGION.backblazeb2.com
OFFSITE_BACKUP_S3_REGION=REPLACE_WITH_REGION
OFFSITE_BACKUP_S3_BUCKET=REPLACE_WITH_PRIVATE_OBJECT_LOCK_BUCKET
OFFSITE_BACKUP_S3_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_KEY_ID
OFFSITE_BACKUP_S3_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_APPLICATION_KEY
OFFSITE_BACKUP_RETENTION_DAYS=180
OFFSITE_BACKUP_OBJECT_LOCK_MODE=COMPLIANCE
