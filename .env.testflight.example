# Copy this file to .env.testflight. That file and all .p8 keys are ignored.
# App Store Connect > Users and Access > Integrations must first have API access.
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_KEYID.p8

# Optional. The default is the standard Custody Folio beta test checklist.
TESTFLIGHT_WHAT_TO_TEST=
