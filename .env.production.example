# Custody Folio production environment template.
# Copy these values into the production host secret manager.
# Do not commit a real .env.production file.

NEXT_PUBLIC_APP_URL=https://custodyfolio.com
NEXT_PUBLIC_RECORDS_HOST=custodyfolio.com
NEXT_PUBLIC_RECORDS_STORAGE_MODE=supabase
NEXT_PUBLIC_RECORDS_SIGNUPS_ENABLED=false
RECORDS_STORAGE_MODE=supabase
RECORDS_SIGNUPS_ENABLED=false
# Keep true while this installation uses the 4 GiB starter profile. This emits
# a capacity warning but does not block customer use or an App Store release.
STARTER_RESOURCE_PROFILE=true

# Production Supabase project: losttofound-records-production.
NEXT_PUBLIC_SUPABASE_URL=https://cieuilbpnwuvnrxrlczj.supabase.co
EXPECTED_SUPABASE_PROJECT_REF=cieuilbpnwuvnrxrlczj
# Use the active Supabase publishable key named "default" from the production project.
# Prefer the sb_publishable_... key over the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_DEFAULT_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
# Privacy preserving first party growth measurement remains disabled by
# default. Enabling it requires a separate secret and approved retention.
MARKETING_ANALYTICS_ENABLED=false
MARKETING_ANALYTICS_SECRET=REPLACE_WITH_SEPARATE_32_PLUS_CHARACTER_RANDOM_SECRET
# Server-only comma-separated UUIDs of verified owner/test accounts. Required by growth:scorecard.
# Keep values private; update when a new internal account is created. Never use a guessed list.
GROWTH_EXCLUDED_USER_IDS=
CUSTOMER_FEEDBACK_INVITE_ENABLED=false
CUSTOMER_GROWTH_SCHEMA_VERIFIED_AT=

# Passwordless email-code authentication. Set these only after the matching
# Supabase email template and provider controls are live.
RECORDS_AUTH_METHOD=email_otp
SUPABASE_EMAIL_OTP_ENABLED=true
SUPABASE_EMAIL_OTP_LENGTH=6
SUPABASE_EMAIL_OTP_EXPIRY_SECONDS=600
SUPABASE_MFA_POLICY=optional
RECORDS_ENFORCE_MFA=false
SUPABASE_CUSTOM_SMTP_ENABLED=true
SUPABASE_AUTH_REDIRECTS_VERIFIED_AT=YYYY-MM-DD
# Password controls remain documented only for any provider-level legacy identity;
# Custody Folio does not expose password signup, login, recovery, or update routes.
SUPABASE_LEAKED_PASSWORD_PROTECTION_ENABLED=false
PWNED_PASSWORD_CHECK_ENABLED=false
SUPABASE_PASSWORD_MIN_LENGTH=12
SUPABASE_PASSWORD_REAUTH_ENABLED=false
SUPABASE_CURRENT_PASSWORD_REQUIRED=false
SUPABASE_AUTH_HARDENING_VERIFIED_AT=YYYY-MM-DD

# Records storage and session controls.
RECORDS_EVIDENCE_BUCKET=records-evidence
RECORDS_DATASET_MAX_BYTES=2000000
RECORDS_ALLOW_BEARER_AUTH=false
AUTH_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
AUTH_TRUST_HOST=true

# Billing is intentionally disabled in the committed production template.
# Do not change this to live until every BILLING_LAUNCH_CHECKLIST.md gate is
# evidenced and the user explicitly authorizes activation.
BILLING_MODE=disabled
BILLING_CHECKOUT_ENABLED=false
LIVE_BILLING_APPROVED=false
BILLING_LIVE_ACTIVATION_AUTHORIZED=false
# Temporary internal live-charge canary. Global checkout must remain false,
# the exact user UUID must be allowlisted, and the authorization expires in 24h or less.
BILLING_LIVE_CANARY_AUTHORIZED=false
BILLING_LIVE_CANARY_USER_ID=
BILLING_LIVE_CANARY_EXPIRES_AT=
BILLING_RETURN_STATE_SECRET=REPLACE_WITH_SEPARATE_32_PLUS_CHARACTER_RANDOM_SECRET
BILLING_DELETION_HASH_SECRET=REPLACE_WITH_ANOTHER_32_PLUS_CHARACTER_RANDOM_SECRET
BILLING_GRACE_PERIOD_DAYS=7
BILLING_STALE_TOLERANCE_HOURS=72
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_MONTHLY_PRICE_ID=
STRIPE_TEST_ANNUAL_PRICE_ID=
STRIPE_TEST_PORTAL_CONFIGURATION_ID=
STRIPE_LIVE_RESTRICTED_KEY=REPLACE_WITH_LEAST_PRIVILEGE_RK_LIVE_KEY
STRIPE_LIVE_WEBHOOK_SECRET=REPLACE_WITH_LIVE_WEBHOOK_SIGNING_SECRET
STRIPE_LIVE_MONTHLY_PRICE_ID=price_1U4UJ7IcPfzDuv3F7wUsUHVZ
STRIPE_LIVE_ANNUAL_PRICE_ID=price_1U4UJHIcPfzDuv3F9khkkrfH
STRIPE_LIVE_PORTAL_CONFIGURATION_ID=bpc_1U4UKUIcPfzDuv3FYdyEsKyV
STRIPE_CUSTOMER_PORTAL_VERIFIED_AT=2026-08-14
# Dual-provider launch target: Stripe Checkout on web and StoreKit in iOS.
# Keep false in this fail-closed template; set true only during the approved
# App Store activation window after every Apple gate is evidenced.
APPLE_PURCHASE_ENABLED=false
# A rollback-protected TestFlight acceptance window may authorize one app user
# for at most two hours without opening global Apple purchases.
APPLE_TESTFLIGHT_CANARY_AUTHORIZED=false
APPLE_TESTFLIGHT_CANARY_USER_ID=
APPLE_TESTFLIGHT_CANARY_EXPIRES_AT=
# Time-bounded exception for the dedicated synthetic App Review account only.
APPLE_REVIEW_SANDBOX_ENABLED=false
APPLE_REVIEW_SANDBOX_USER_ID=
APPLE_REVIEW_SANDBOX_EXPIRES_AT=
APPLE_REVIEW_AUTH_CODE_SHA256=
APPLE_REVIEW_ATTORNEY_USER_ID=
APPLE_REVIEW_ATTORNEY_AUTH_CODE_SHA256=
APPLE_BILLING_ENVIRONMENT=production
# Compatibility identity of the existing App Store app.
APPLE_BUNDLE_ID=io.lendori.losttofound
APPLE_APP_ID=6789433883
APPLE_MONTHLY_PRODUCT_ID=io.custodyfolio.subscription.monthly
APPLE_ANNUAL_PRODUCT_ID=io.custodyfolio.subscription.annual
APPLE_ROOT_CA_CERTIFICATES_BASE64=REPLACE_WITH_JSON_ARRAY_OF_DER_CERTIFICATES_BASE64
APPLE_APP_STORE_SERVER_PRIVATE_KEY_BASE64=REPLACE_WITH_PKCS8_PRIVATE_KEY_BASE64
APPLE_APP_STORE_SERVER_KEY_ID=REPLACE_WITH_KEY_ID
APPLE_APP_STORE_SERVER_ISSUER_ID=REPLACE_WITH_ISSUER_ID
APPLE_NOTIFICATIONS_V2_URL=https://custodyfolio.com/api/records/billing/apple/notifications
APPLE_NOTIFICATIONS_V2_VERIFIED_AT=YYYY-MM-DD
APPLE_SMALL_BUSINESS_PROGRAM_STATUS=REPLACE_WITH_enrolled_not_enrolled_or_not_eligible
BILLING_PROVIDER_TESTED_AT=YYYY-MM-DD
BILLING_RECONCILIATION_TESTED_AT=YYYY-MM-DD
BILLING_MIGRATION_VERIFIED_AT=2026-08-14
BILLING_TERMS_VERSION=2026-08-23
BILLING_PRIVACY_VERSION=2026-08-31
BILLING_SUBPROCESSOR_VERSION=2026-08-23
BILLING_DISCLOSURE_VERSION=2026-08-23-stripe-web
BILLING_POLICY_APPROVED=false
BILLING_POLICY_APPROVAL_BASIS=operator_self_review
BILLING_POLICY_VERSIONS_VERIFIED_AT=YYYY-MM-DD
STRIPE_TAX_MODE=disabled
BILLING_TAX_REVIEW_APPROVED=false
BILLING_TAX_REVIEWED_AT=YYYY-MM-DD
STRIPE_TAX_REGISTRATIONS_VERIFIED_AT=
STRIPE_TAX_PRODUCT_CONFIGURATION_VERIFIED_AT=

# Attorney guest lifecycle. Owner shared links may be enabled after deployment
# review. Development links must always stay off in production.
ATTORNEY_GUEST_FEATURE_ENABLED=false
ATTORNEY_PORTAL_SECRET=REPLACE_WITH_SEPARATE_32_PLUS_CHARACTER_RANDOM_SECRET
ATTORNEY_INVITE_OWNER_SHARE_ENABLED=false
ATTORNEY_INVITE_DEV_DELIVERY=false

# Optional AI import assistant. Enable only after vendor/security review.
RECORDS_AI_IMPORT_ENABLED=false
RECORDS_AI_IMPORT_MAX_CHARS=12000
OPENAI_API_KEY=REPLACE_WITH_SERVER_ONLY_OPENAI_API_KEY
OPENAI_IMPORT_MODEL=gpt-5.5

# Evidence intake.
EVIDENCE_MAX_FILE_BYTES=10485760
MALWARE_SCAN_PROVIDER=REPLACE_WITH_clamav_clamd_http_or_webhook
MALWARE_SCANNER_TESTED_AT=YYYY-MM-DD
CLAMAV_HOST=REPLACE_WITH_CLAMAV_HOST
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# Starter 4 GiB host profile. At the capacity upgrade, move to at least 8 GiB
# and set CLAMAV_MEMORY_LIMIT=4096m after the reload and malware checks pass.
CLAMAV_MEMORY_LIMIT=2560m
CLAMAV_CPU_LIMIT=1.5
LOSTTOFOUND_MEMORY_LIMIT=768m
CADDY_MEMORY_LIMIT=128m
MALWARE_SCAN_ENDPOINT=
MALWARE_SCAN_API_KEY=

# Security monitoring.
SECURITY_CONTACT_EMAIL=security@custodyfolio.com
PRIVACY_POLICY_URL=https://custodyfolio.com/privacy
SECURITY_EVENT_SINK=REPLACE_WITH_platform_siem_or_webhook
SECURITY_EVENT_WEBHOOK_URL=
SECURITY_EVENT_WEBHOOK_TOKEN=
SECURITY_LOG_HASH_SALT=REPLACE_WITH_RANDOM_LOG_HASH_SALT

# Edge/provider controls.
EDGE_RATE_LIMITING_ENABLED=true
EDGE_RATE_LIMITING_PROVIDER=REPLACE_WITH_PROVIDER_NAME
EDGE_WAF_ENABLED=true
EDGE_WAF_PROVIDER=REPLACE_WITH_PROVIDER_NAME
EDGE_CONTROLS_TESTED_AT=YYYY-MM-DD
SECURITY_MONITORING_ENABLED=true
AUDIT_LOG_REVIEW_ENABLED=true

# Set after the corresponding verification is actually complete.
BACKUP_RESTORE_TESTED_AT=YYYY-MM-DD
# Keep the S3 credentials in /srv/losttofound/config/backup.env, not here.
OFFSITE_STORAGE_BACKUP_ENABLED=true
OFFSITE_STORAGE_BACKUP_RETENTION_DAYS=178
OFFSITE_STORAGE_BACKUP_LIFECYCLE_DELETE_DAYS=1
OFFSITE_STORAGE_BACKUP_KEY_EXPIRES_AT=YYYY-MM-DD
TWO_USER_ISOLATION_TESTED_AT=YYYY-MM-DD
DATA_RETENTION_POLICY_APPROVED=false
INCIDENT_RESPONSE_PLAN_APPROVED=false
LEGAL_REVIEW_APPROVED=false
# Generate a protected template with `npm run approval:prepare`. After real
# reviewers complete it and `npm run verify:approvals` succeeds, put the
# verifier's base64url output here and then change only the approved flags.
PRODUCTION_APPROVAL_MANIFEST_BASE64=
VENDOR_SECURITY_REVIEW_APPROVED=true

# Synthetic live verification helpers. Use synthetic users and data only.
RECORDS_APP_BASE_URL=https://custodyfolio.com
RECORDS_ISOLATION_EMAIL_DOMAIN=example.test
KEEP_ISOLATION_TEST_USERS=false
