# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/tmp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.p8

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example
!.env.testflight.example
/deploy/production/backup.env

# production evidence artifacts
/ops/backup-restore-evidence.json
/ops/*-restore-evidence.json
!/ops/backup-restore-evidence.example.json
/ops/production-approval-manifest.json
/ops/privacy-rights-request.json
/ops/privacy-rights-requests/
!/ops/privacy-rights-request.example.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# xcode user state
xcuserdata/
*.xcuserstate
